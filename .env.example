# Vercel project environment variables (Settings → Environment Variables).
# Never commit real values. The browser never sees any of these.
SUPABASE_URL=https://xiirhismxuahujdcxsuw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional: salt for hashing reporter IP addresses (defaults to the service key)
IP_HASH_SALT=
# Optional: Cloudflare Turnstile secret; when set, /api/report and /api/join require a token
TURNSTILE_SECRET=
# Optional: Google Maps Platform key (Geocoding API) for place search; without it the API uses OpenStreetMap Nominatim
GOOGLE_MAPS_KEY=
# Optional: the publishable (anon) key, used only for volunteer sign-in calls; falls back to the service key
SUPABASE_ANON_KEY=
# Daily cron (/api/cron/daily): Vercel sends Authorization: Bearer <CRON_SECRET>. Required for the SLA digest, stage-change emails and the 24-month retention sweep.
CRON_SECRET=
# Where the daily SLA digest goes (overdue reports; counts and references only)
COORDINATOR_EMAIL=
# Resend API key for outgoing email (stage changes to reporters and followers, the digest). Without it, mail queues in the outbox.
RESEND_API_KEY=
# Sender shown on outgoing mail; the domain must be verified in Resend
MAIL_FROM=Gurugram Vision Forum <noreply@gurugramvisionforum.org>
# WhatsApp Business (Meta Cloud API) webhook at /api/hooks/whatsapp, once Meta verification is done
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Approved utility template for the morning brief to owners (one body parameter, the one-line brief)
WHATSAPP_BRIEF_TEMPLATE=gvf_daily_brief
# Inbound mail into the desk inbox at /api/hooks/email: Resend "email.received" webhooks (Svix secret) and/or any forwarder with ?token=
RESEND_WEBHOOK_SECRET=
EMAIL_HOOK_TOKEN=
# Exotel helpline webhook at /api/hooks/exotel?token=<EXOTEL_WEBHOOK_TOKEN>
EXOTEL_WEBHOOK_TOKEN=
# "Draft with AI" in the desk's content dashboard. Set ONE of these; free tiers first.
# Google AI Studio (https://aistudio.google.com/apikey), free, no card: the default when set.
GEMINI_API_KEY=
# Groq (https://console.groq.com/keys), free tier, no card.
GROQ_API_KEY=
# Claude (paid); only used when no free key is set, or DRAFT_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Optional: force a provider (gemini | groq | anthropic) or a model id.
DRAFT_PROVIDER=
DRAFT_MODEL=
# Search visibility. SITE_URL is the public origin used in canonical links, the sitemap, emails and IndexNow
# (defaults to the Vercel production URL until the domain is set; set it to https://gurugramvisionforum.org once bought).
SITE_URL=
# IndexNow key (8-128 letters, digits, dashes): served at /indexnow-key.txt; the cron pings Bing/Yandex/Naver when posts publish. Leave empty to switch off.
INDEXNOW_KEY=
# Google Search Console HTML-file verification: the file name Google gives you (googleXXXX.html); the API answers it at the root.
# DNS verification of the domain (TXT record in Vercel) is simpler once the domain is bought; then this stays empty.
GSC_FILE=
